{
  "manifest_version": 3,
  "name": "BNTrans - Power Inline Translate Kit",
  "version": "1.0.0",
  "version_name": "1.0.0-labs.2",
  "description": "Brings instant, AI-powered translation directly to your input fields. No more switching tabs or copy-pasting—just type translate",
  "author": "BNTrans",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "BNTrans",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script-granularity.js", "src/content-script.js"],
      "css": [
        "assets/styles/inline-suggestion.css",
        "assets/styles/selection.css",
        "assets/styles/hover-translate.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/experimental/content-learning.js",
        "src/experimental/content-writing.js",
        "src/experimental/content-media.js",
        "src/experimental/content-reading.js",
        "src/experimental/content-corrections.js",
        "src/experimental/content-images.js",
        "src/experimental/content-readalong.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "offscreen", "contextMenus", "sidePanel"],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/*",
        "assets/styles/*",
        "assets/fonts/*",
        "pages/*",
        "src/*",
        "src/experimental/learning-store.js",
        "src/experimental/learning-frequency.js",
        "src/experimental/learning-frequency-data.js",
        "src/experimental/reading-context.js",
        "src/experimental/image-translation-utils.js",
        "src/experimental/ocr-utils.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
